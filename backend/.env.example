DEBUG=True
SECRET_KEY=replace-with-a-long-random-string
DB_NAME=garage_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your-db-host.example.com
DB_PORT=5432# 'disable' for a local Postgres without TLS
DB_SSLMODE=require

# Subscription billing (leave the Flutterwave keys empty to use manual payments)
FRONTEND_URL=http://localhost:3000
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
MANUAL_PAYMENT_INSTRUCTIONS=

# MTN Mobile Money (leave keys empty to hide). Sandbox shown; see README.
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_CURRENCY=EUR
MTN_MOMO_CALLBACK_URL=
